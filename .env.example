# ── 資料庫（必填） ───────────────────────────────────────────
# Neon Postgres 連線字串，從 Neon 主控台複製（形如 postgresql://user:pass@xxx.neon.tech/dbname?sslmode=require）
# 本機與雲端都用同一條（本機 npm run dev / collect 也會連到雲端）。
DATABASE_URL=

# ── AI 重要性評分與摘要（選填） ──────────────────────────────
# 填入 Anthropic API 金鑰後，會用 Claude Haiku 自動判斷新聞重要性並生成一句話摘要。
# 不填則改用「關鍵字權重」判斷重大新聞，摘要直接用新聞原本的描述。
ANTHROPIC_API_KEY=

# ── 每日摘要推播（選填） ─────────────────────────────────────
# 以下都不填 → 摘要只印在 console。擇一設定即可。

# (A) Microsoft Teams Incoming Webhook
TEAMS_WEBHOOK_URL=

# (B) Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_EMAIL_FROM=
DIGEST_EMAIL_TO=

# ── 排程（選填，預設值如下） ─────────────────────────────────
# 每小時整點抓新聞
COLLECT_CRON=0 * * * *
# 每天早上 08:00 寄送前一天重點摘要
DIGEST_CRON=0 8 * * *

# ── 資料保留（選填） ─────────────────────────────────────────
# 只保留最近 N 天的新聞，更舊的在每次蒐集時刪除。
RETENTION_DAYS=30

# ── 公司 LLM gateway（翻譯，選填） ───────────────────────────
# 不填則不翻譯，英文新聞維持原文顯示。
RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://runway.taitra.ai
RUNWAY_MODEL=claude-haiku,gpt-5-chat
TRANSLATE_MAX_PER_RUN=80
